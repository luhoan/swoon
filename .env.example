# Swoon environment — copy to .env.local and fill in. Never commit real values.

# Supabase project (Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=            # https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=       # publishable (anon) key — safe for the browser
SUPABASE_SERVICE_ROLE_KEY=           # secret key — SERVER ONLY, bypasses RLS
SUPABASE_DB_URL=                     # postgres connection string, used only by scripts/db-push

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Feature flags — all fail closed
DEMO_MODE=true                       # verification screen bypasses payment with a demo_bypass state
NEXT_PUBLIC_DEMO_MODE=true           # same value, readable by the client for demo labeling
ADMIN_TOOLS_ENABLED=true

# WebRTC — comma-separated STUN urls; TURN can be appended later without code changes
NEXT_PUBLIC_ICE_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# Test-only: shorten the date for E2E (seconds). NEVER set in production.
DATE_DURATION_SECONDS=
